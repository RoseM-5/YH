---
import SiteLayout from '../../layouts/SiteLayout.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import catalog from '../../data/products.json';
import '../../styles/catalog.css';
const { categories, products } = catalog;
---

<SiteLayout
  title="产品中心"
  description="浏览 YH 固定翼、垂起固定翼、多旋翼、巡飞弹、FPV 套件、机架和发动机产品。"
  lightLanding={true}
>
  <div class="catalog-page catalog-index-page">
    <section class="catalog-banner">
      <div class="catalog-shell">
        <span class="catalog-kicker">YH / PRODUCT SYSTEM</span>
        <h1>产品中心</h1>
        <span class="catalog-banner-rule" aria-hidden="true"></span>
      </div>
    </section>

    <section class="catalog-listing catalog-shell" aria-labelledby="catalog-list-title">
      <div class="catalog-section-head">
        <div>
          <span class="catalog-kicker">EXPLORE THE RANGE</span>
          <h2 id="catalog-list-title">找到所需的产品类型</h2>
        </div>
      </div>

      <div class="catalog-layout">
        <aside class="catalog-sidebar" aria-label="产品分类">
          <p class="catalog-sidebar-title">产品分类</p>
          <button
            type="button"
            class="catalog-mobile-filter"
            data-category-toggle
            aria-controls="catalog-category-options"
            aria-expanded="false"
          >
            <span class="catalog-mobile-filter-label">产品分类</span>
            <strong data-current-category>全部产品</strong>
            <span class="catalog-mobile-filter-chevron" aria-hidden="true"></span>
          </button>
          <div class="catalog-tabs" id="catalog-category-options" role="group" aria-label="按产品类型筛选">
            <button type="button" class="is-active" data-category-tab="all" aria-pressed="true">
              全部产品
            </button>
            {categories.map((category) => (
              <button type="button" data-category-tab={category.key} aria-pressed="false">
                {category.name}
              </button>
            ))}
          </div>
        </aside>
        <div class="catalog-main">
          <div class="catalog-tools">
            <label class="catalog-search" id="catalog-search">
              <span class="sr-only">搜索型号和产品类型</span>
              <input
                data-catalog-search
                type="search"
                autocomplete="off"
                placeholder="搜索型号或产品类型"
              />
              <span aria-hidden="true">⌕</span>
            </label>
          </div>

          <p class="catalog-results" role="status" aria-live="polite" data-results-count>
            显示 {products.length} 个型号
          </p>
          <div class="catalog-grid">
            {products.map((product) => (
              <CatalogCard product={product} />
            ))}
          </div>
          <p class="catalog-empty" data-catalog-empty hidden>
            没有匹配的型号，请更换关键词或产品类型。
          </p>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  const english = document.documentElement.lang === 'en';
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-tab]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-card]'));
  const input = document.querySelector<HTMLInputElement>('[data-catalog-search]');
  const count = document.querySelector<HTMLElement>('[data-results-count]');
  const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');
  const sidebar = document.querySelector<HTMLElement>('.catalog-sidebar');
  const toggle = document.querySelector<HTMLButtonElement>('[data-category-toggle]');
  const currentCategory = document.querySelector<HTMLElement>('[data-current-category]');
  const params = new URLSearchParams(location.search);
  const initialCategory = params.get('category') || 'all';
  let category = tabs.some((tab) => tab.dataset.categoryTab === initialCategory)
    ? initialCategory
    : 'all';
  let query = params.get('q') || '';
  if (input) input.value = query;

  const render = (updateUrl = false) => {
    const normalized = query.trim().toLocaleLowerCase();
    let visible = 0;
    tabs.forEach((tab) => {
      const active = tab.dataset.categoryTab === category;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-pressed', String(active));
    });
    if (currentCategory) {
      currentCategory.textContent = tabs.find((tab) => tab.dataset.categoryTab === category)?.textContent?.trim() || (english ? 'All products' : '全部产品');
    }
    cards.forEach((card) => {
      const matched =
        (category === 'all' || card.dataset.category === category) &&
        (!normalized || (card.dataset.search || '').includes(normalized));
      card.hidden = !matched;
      if (matched) visible += 1;
    });
    if (count) count.textContent = english ? `Showing ${visible} models` : `显示 ${visible} 个型号`;
    if (empty) empty.hidden = visible !== 0;
    if (updateUrl) {
      const url = new URL(location.href);
      if (category === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', category);
      if (query.trim()) url.searchParams.set('q', query.trim());
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    }
  };
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      category = tab.dataset.categoryTab || 'all';
      render(true);
      sidebar?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      if (matchMedia('(max-width: 700px)').matches) toggle?.focus();
    }),
  );
  toggle?.addEventListener('click', () => {
    const open = sidebar?.classList.toggle('is-open') || false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (event) => {
    if (!sidebar?.contains(event.target as Node)) {
      sidebar?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && sidebar?.classList.contains('is-open')) {
      sidebar.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
  input?.addEventListener('input', () => {
    query = input.value;
    render(true);
  });
  window.addEventListener('popstate', () => {
    const state = new URLSearchParams(location.search);
    category = state.get('category') || 'all';
    query = state.get('q') || '';
    if (input) input.value = query;
    render();
  });
  render();
  const focusSearchFromNavigation = () => {
    if (location.hash === '#catalog-search') input?.focus({ preventScroll: true });
  };
  window.addEventListener('hashchange', focusSearchFromNavigation);
  requestAnimationFrame(focusSearchFromNavigation);
</script>
