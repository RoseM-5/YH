---
import SiteLayout from '../../layouts/SiteLayout.astro';
import catalog from '../../data/products.json';
import '../../styles/catalog.css';

export function getStaticPaths() {
  return catalog.products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

const { product } = Astro.props;
const description = product.description?.trim() || product.descriptionOriginal?.trim() || `${product.categoryName}。${product.summary}`;
const detailImages = product.imageTypes?.product_detail ?? [];
const galleryOptions = [product.gallery[0], ...detailImages];
---

<SiteLayout
  title={`${product.model} · ${product.categoryName}`}
  description={`${product.model} ${product.categoryName}。${product.summary}`}
  lightLanding={true}
>
  <div class="catalog-page catalog-detail-page">
    <section class="catalog-detail-intro catalog-shell" aria-labelledby="product-model">
      <div class="catalog-detail-copy">
        <a class="catalog-back-link" href={`/products/?category=${product.categoryKey}`}>
          ← 返回{product.categoryName}
        </a>
        <h1 id="product-model">{product.model}</h1>
        <p>{description}</p>
      </div>
      <div class="catalog-detail-visual">
        <div class="catalog-detail-image">
          <img
            src={product.bestImage}
            alt={product.bestImageAlt}
            width={product.gallery[0]?.width}
            height={product.gallery[0]?.height}
            fetchpriority="high"
            decoding="async"
            data-gallery-main
          />
        </div>
        {detailImages.length > 0 && (
          <div class="catalog-detail-thumbs" role="group" aria-label={`${product.model} 图片视图`}>
            {galleryOptions.map((image, index) => (
              <button
                type="button"
                class:list={['catalog-detail-thumb', { 'is-active': index === 0 }]}
                aria-label={index === 0 ? '查看产品主图' : `查看${image.alt}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-gallery-option
                data-gallery-src={image.src}
                data-gallery-alt={image.alt}
              >
                <img src={image.src} alt="" width={image.width} height={image.height} loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        )}
      </div>
    </section>

    <section class="catalog-spec-section catalog-shell" aria-labelledby="detail-specs-title">
      <h2 id="detail-specs-title">详细参数</h2>
      <div class="catalog-spec-table-wrap">
        <table class="catalog-spec-table">
          <caption class="sr-only">{product.model} 详细参数</caption>
          <thead>
            <tr><th scope="col">参数</th><th scope="col">数值</th></tr>
          </thead>
          <tbody>
            {product.specs.map((spec) => (
              <tr><th scope="row">{spec.label}</th><td>{spec.value}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</SiteLayout>

<script>
  const mainImage = document.querySelector<HTMLImageElement>('[data-gallery-main]');
  const options = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-option]'));
  options.forEach((option) => option.addEventListener('click', () => {
    if (!mainImage) return;
    mainImage.src = option.dataset.gallerySrc || mainImage.src;
    mainImage.alt = option.dataset.galleryAlt || mainImage.alt;
    options.forEach((item) => {
      const active = item === option;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-pressed', String(active));
    });
  }));
</script>
