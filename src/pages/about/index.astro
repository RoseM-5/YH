---
import SiteLayout from '../../layouts/SiteLayout.astro';
import catalog from '../../data/products.json';

const products = catalog.products;
const categoryCount = new Set(products.map((product) => product.categoryKey)).size;
const feature = products.find((product) => product.model === 'YH-2000') ?? products[0];
---

<SiteLayout title="关于我们" description="了解 YH 产品资料展示站与产品信息的整理方式。">
  <section class="info-hero" style={`--info-image: url('${feature.bestImage}')`}>
    <div class="wrap info-hero-content">
      <span class="eyebrow">ABOUT / YH</span>
      <h1>
        以清晰的产品资料，
        <br />
        <em>认识每一种平台。</em>
      </h1>
      <p>从无人机平台到动力系统与碳纤维机架，按产品类型浏览与核对。</p>
    </div>
  </section>
  <section class="wrap info-section" data-reveal>
    <div>
      <span class="eyebrow">PRODUCTS / 01</span>
      <h2>产品信息</h2>
    </div>
    <div class="info-copy">
      <p>
        本站展示 YH 的 {products.length} 个产品型号，涵盖 {categoryCount} 类无人机平台、动力系统与机架。可按产品类型浏览图片、描述和详细参数。
      </p>
      <p>
        不同型号的载荷、航时、链路与配置应分别查看；具体供货和应用能力以正式配置资料为准。
      </p>
      <a class="info-link" href="/products/">
        浏览产品体系 <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="wrap info-section info-section-last" data-reveal>
    <div>
      <span class="eyebrow">CONTENT / 02</span>
      <h2>从产品到应用</h2>
    </div>
    <div class="info-copy">
      <p>
        解决方案结合产品类别和参数，整理航测、设施巡检、应急观察和结构集成等任务思路。行业观察引用的公开案例用于说明作业需求，不表示案例机构使用
        YH 产品。
      </p>
      <a class="info-link" href="/solutions/">
        阅读解决方案 <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</SiteLayout>
