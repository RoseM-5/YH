---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeTaskShowcase from '../components/HomeTaskShowcase.astro';
import HomeLatest from '../components/HomeLatest.astro';
import HomeClosing from '../components/HomeClosing.astro';
import catalog from '../data/products.json';
import { missionContent as mission } from '../data/mission-scenes';
import '../styles/home.css';
import '../styles/home-after.css';

const products = catalog.products;
const closingVisuals = ['YH-1000', 'YH-3001', 'YH-2008', 'YH-2000']
  .map((model) => products.find((product) => product.model === model))
  .filter((product): product is (typeof products)[number] => product !== undefined)
  .map((product) => ({
    id: product.id,
    model: product.model,
    image: product.bestImage,
    alt: product.bestImageAlt,
    category: product.categoryName,
    performance: product.summary,
  }));
---

<SiteLayout
  title="YH｜专业飞行装备"
  description="让专业飞行装备，抵达世界每一个重要现场。浏览 YH 产品、解决方案和动态。"
  home={true}
>
  <HomeHero />
  <HomeClosing visuals={closingVisuals} />
  <HomeTaskShowcase stories={mission.solutions.slice(5, 8)} />
  <HomeLatest articles={mission.articles.slice(0, 5)} />
</SiteLayout>

<script>
  import '../scripts/home.ts';
  import '../scripts/home-after.ts';
</script>
