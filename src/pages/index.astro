---
import SiteLayout from '../layouts/SiteLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeProducts from '../components/HomeProducts.astro';
import HomeApplications from '../components/HomeApplications.astro';
import HomeInsights from '../components/HomeInsights.astro';
import catalog from '../data/products.json';
import { solutions, articles } from '../data/editorial';
import '../styles/home.css';

const products = catalog.products;
const featuredModels = ['MD-G48', 'YH-2000', 'Y-500', 'MD-X8', 'WP-4000'];
const featured = featuredModels
  .map((model) => products.find((product) => product.model === model))
  .filter((product): product is (typeof products)[number] => product !== undefined);
const promoProduct = products.find((product) => product.model === 'YH-1000');
---

<SiteLayout
  title="YH｜专业飞行装备"
  description="让专业飞行装备，抵达世界每一个重要现场。浏览 YH 产品、解决方案和动态。"
  home={true}
>
  <HomeHero />
  <HomeProducts products={featured} promoProduct={promoProduct} />
  <HomeApplications solutions={solutions.slice(0, 4)} />
  <HomeInsights articles={articles.slice(0, 4)} />
</SiteLayout>

<script>
  import '../scripts/home.ts';
</script>
