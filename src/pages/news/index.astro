---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EditorialCard from '../../components/EditorialCard.astro';
import NewsCarousel from '../../components/NewsCarousel.astro';
import Topography from '../../components/Topography.jsx';
import { missionContent } from '../../data/mission-scenes';
import { articles as editorialArticles } from '../../data/editorial';
import '../../styles/editorial.css';

const featuredArticles = missionContent.articles.slice(5, 8);
const editorialLatest = editorialArticles
  .filter((article) => ['repeatable-aerial-imagery', 'facility-inspection-workflow', 'disaster-communication-system'].includes(article.slug))
  .map((article) => ({
    ...article,
    ...(article.slug === 'repeatable-aerial-imagery'
      ? { image: '/media/scenes/river-boundary.webp', imageAlt: '场景示意：森林中的河道与周边地形' }
      : article.slug === 'facility-inspection-workflow'
        ? { image: '/media/scenes/power-corridor.webp', imageAlt: '场景示意：穿越林地的设施通道' }
        : { image: '/media/scenes/rescue-observation.webp', imageAlt: '场景示意：洪水后道路与建筑的区域观察' }),
  }));
const latestArticles = [
  ...missionContent.articles.slice(8).map((article) => ({ ...article, slug: `mission/${article.slug}` })),
  ...editorialLatest,
];
---

<SiteLayout
  title="新闻与活动"
  description="阅读 YH 巡检、救援与灾后侦察文章；活动时间及报名方式确认后公布。"
  newsLanding={true}
>
  <div class="news-landing">
    <header class="news-masthead">
      <div class="news-topography" aria-hidden="true">
        <Topography
          client:visible
          color="#2379b7"
          lineCount={26}
          lineWidth={1.55}
          glow={0.18}
          speed={0.16}
          morph={0.14}
          brightness={1.25}
          opacity={0.96}
          mouseInteraction={false}
          clickEffect="none"
          markers="none"
          dpr={1.5}
        />
      </div>
      <div class="editorial-wrap news-masthead-content">
        <span class="editorial-kicker">INSIGHTS &amp; EVENTS</span>
        <h1>新闻与活动</h1>
        <p>从巡检、救援与灾后侦察出发，阅读平台选型与现场任务思路。</p>
      </div>
    </header>

    <section class="editorial-section news-featured" aria-labelledby="featured-title">
      <div class="editorial-wrap">
        <div class="editorial-section-head" data-reveal>
          <div>
            <span class="editorial-kicker">EDITOR'S PICK</span>
            <h2 id="featured-title">精选资讯</h2>
          </div>
        </div>
        <div class="editorial-card-grid news-feature-grid">
          {featuredArticles.map((article, index) => (
            <EditorialCard
              href={`/news/mission/${article.slug}/`}
              image={article.image}
              imageAlt={article.imageAlt}
              index={String(index + 1).padStart(2, '0')}
              topic={article.topic}
              title={article.title}
              summary={article.summary}
              layout="overlay"
              className={index === 0 ? 'is-lead' : ''}
            />
          ))}
        </div>
      </div>
    </section>

    <NewsCarousel articles={latestArticles} />

    <section class="editorial-activity news-activity" aria-labelledby="activity-title">
      <div class="editorial-wrap editorial-activity-inner" data-reveal>
        <div>
          <span class="editorial-kicker">EVENTS / UPDATE</span>
          <h2 id="activity-title">活动信息待公布</h2>
        </div>
        <p>时间与报名方式确认后更新</p>
      </div>
    </section>
  </div>
</SiteLayout>
