---
import { articles } from '../../data/editorial';

export function getStaticPaths() {
  return articles.map(({ slug }) => ({ params: { slug } }));
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/news/" />
    <meta name="robots" content="noindex" />
    <title>文章已更新 | YH</title>
  </head>
  <body><p>文章已更新。<a href="/news/">查看新闻与活动</a></p></body>
</html>
