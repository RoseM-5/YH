---
import MissionStory from '../../../components/MissionStory.astro';
import { missionContent as content } from '../../../data/mission-scenes';

export function getStaticPaths() {
  const legacySlugs = ['patrol-records', 'long-range-selection', 'rescue-information', 'night-search', 'platform-selection'];
  return [
    ...content.articles.map((story) => ({ params: { slug: story.slug }, props: { story } })),
    ...legacySlugs.map((slug) => ({ params: { slug }, props: { redirectTo: '/news/' } })),
  ];
}
const { story, redirectTo } = Astro.props;
---

{story ? <MissionStory story={story} kind="article" /> : (
  <html lang="zh-CN">
    <head>
      <meta charset="UTF-8" />
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
      <meta name="robots" content="noindex" />
      <title>文章已更新 | YH</title>
    </head>
    <body><p>文章已更新。<a href={redirectTo}>查看新闻与活动</a></p></body>
  </html>
)}
