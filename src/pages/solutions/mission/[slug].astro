---
import MissionStory from '../../../components/MissionStory.astro';
import { missionContent as content } from '../../../data/mission-scenes';

export function getStaticPaths() {
  const legacySlugs = ['park-patrol', 'corridor-patrol', 'mountain-rescue', 'disaster-recon', 'area-observation'];
  return [
    ...content.solutions.map((story) => ({ params: { slug: story.slug }, props: { story } })),
    ...legacySlugs.map((slug) => ({ params: { slug }, props: { redirectTo: '/solutions/' } })),
  ];
}
const { story, redirectTo } = Astro.props;
---

{story ? <MissionStory story={story} kind="solution" /> : (
  <html lang="zh-CN">
    <head>
      <meta charset="UTF-8" />
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
      <meta name="robots" content="noindex" />
      <title>方案已更新 | YH</title>
    </head>
    <body><p>方案已更新。<a href={redirectTo}>查看解决方案</a></p></body>
  </html>
)}
