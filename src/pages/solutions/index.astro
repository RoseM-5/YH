---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { missionContent } from '../../data/mission-scenes';
import '../../styles/mission.css';

// The three homepage task stories have their own entry point. This page shows the other seven.
const solutions = [...missionContent.solutions.slice(0, 5), ...missionContent.solutions.slice(8)];
---

<SiteLayout title="解决方案" description="浏览 YH 巡检、救援与侦察任务方案，按现场需求选择平台。" lightLanding={true}>
  <div class="mission-landing">
    <header class="mission-hero">
      <div class="mission-hero-copy">
        <span class="mission-eyebrow">YH / SOLUTIONS</span>
        <h1>解决方案</h1>
        <p>从任务出发，选择平台。</p>
      </div>
    </header>

    <div class="mission-intro mission-shell">
      <span class="mission-eyebrow">PATROL / RESCUE / RECON</span>
      <h2 id="mission-stories-title">按任务场景浏览</h2>
      <p>围绕巡检、救援与灾后侦察中的现场问题，查看任务路径和对应平台。</p>
    </div>

    <section class="mission-reel" data-mission-reel aria-labelledby="mission-stories-title" style={`--mission-count: ${solutions.length}`}>
      <div class="mission-reel-stage">
        <div class="mission-reel-rail" aria-hidden="true">
          <span class="mission-reel-rail-base"></span>
          <span class="mission-reel-rail-fill" data-reel-fill></span>
          <span class="mission-reel-rail-dot" data-reel-dot></span>
        </div>
        <div class="mission-reel-count" aria-live="off"><span data-reel-count>01</span> / {String(solutions.length).padStart(2, '0')}</div>
        <div class="mission-reel-frames">
          {solutions.map((solution, index) => (
            <article class="mission-reel-frame" data-reel-frame>
              <div class="mission-reel-copy">
                <span class="mission-reel-number">{String(index + 1).padStart(2, '0')} / {solution.topic}</span>
                <h3>{solution.title}</h3>
                <p>{solution.summary}</p>
                <a href={`/solutions/mission/${solution.slug}/`} class="mission-text-link">了解方案 <span aria-hidden="true">↗</span></a>
              </div>
              <a class="mission-reel-visual" href={`/solutions/mission/${solution.slug}/`} aria-label={`阅读${solution.title}`}>
                <img src={solution.image} alt={solution.imageAlt} loading="lazy" decoding="async" />
                <span class="mission-reel-model">{solution.imageLabel}</span>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

  </div>
  <script>import '../../scripts/mission-reel.ts';</script>
</SiteLayout>
