---
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/contact.css';
---

<SiteLayout title="联系我们" description="通过电子邮件或 WhatsApp 联系 YH。" lightLanding={true}>
  <div class="contact-page">
    <section class="contact-shell" aria-labelledby="contact-title">
      <div class="contact-intro">
        <span class="contact-eyebrow">CONTACT / YH</span>
        <h1 id="contact-title">联系我们</h1>
        <p>关于产品与应用场景，欢迎通过电子邮件或 WhatsApp 与我们交流。</p>
      </div>

      <div class="contact-panel">
        <div class="contact-panel-heading">
          <span class="contact-eyebrow">GET IN TOUCH</span>
          <h2>开启交流</h2>
        </div>
        <div class="contact-methods">
          <div class="contact-method">
            <span class="contact-method-label">电子邮件</span>
            <a class="contact-email" href="mailto:info@yunhetech.net">info@yunhetech.net <span aria-hidden="true">↗</span></a>
          </div>
          <div class="contact-method contact-method-whatsapp">
            <div>
              <span class="contact-method-label">WhatsApp</span>
              <p>使用 WhatsApp 相机扫描二维码，联系 yunhe。</p>
            </div>
            <div class="contact-qr-window">
              <img
                src="/media/contact/whatsapp-yunhe.jpg"
                alt="yunhe 的 WhatsApp 联系二维码"
                width="900"
                height="1600"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
