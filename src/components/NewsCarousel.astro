---
interface Article {
  slug: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  topic: string;
}
interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
---

<section class="news-latest editorial-section" aria-labelledby="latest-title" data-news-carousel>
  <div class="editorial-wrap">
    <div class="news-latest-head" data-reveal>
      <div>
        <span class="editorial-kicker">LATEST INSIGHTS</span>
        <h2 id="latest-title">更多资讯</h2>
        <p>从任务需求到平台选型，持续整理可核查的行业观察与产品思路。</p>
      </div>
    </div>
    <div class="news-carousel-shell">
      <button class="news-carousel-arrow is-prev" type="button" data-news-prev aria-label="上一条资讯" aria-controls="news-carousel-track">←</button>
      <div
        class="news-carousel-track"
        id="news-carousel-track"
        data-news-track
        tabindex="0"
        role="region"
        aria-label="更多资讯，使用左右方向键切换"
      >
        {articles.map((article) => (
          <a
            class="news-carousel-card"
            data-news-slide
            href={`/news/${article.slug}/`}
            aria-label={`${article.title}，阅读文章`}
          >
            <div class="news-carousel-image">
              <img src={article.image} alt={article.imageAlt} loading="lazy" decoding="async" />
            </div>
            <div class="news-carousel-copy">
              <span>{article.topic}</span>
              <h3>{article.title}</h3>
              <p>{article.summary}</p>
            </div>
          </a>
        ))}
      </div>
      <button class="news-carousel-arrow is-next" type="button" data-news-next aria-label="下一条资讯" aria-controls="news-carousel-track">→</button>
    </div>
    <div class="news-carousel-foot" aria-label="轮播进度">
      <div class="news-carousel-progress" aria-hidden="true"><span data-news-progress></span></div>
      <output data-news-count aria-live="polite">01 / {String(articles.length).padStart(2, '0')}</output>
    </div>
    <p class="news-carousel-note">产品参数须结合实际配置和现场条件核定。</p>
  </div>
</section>

<script>
  import '../scripts/news-carousel.ts';
</script>
