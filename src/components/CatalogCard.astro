---
interface ProductCard {
  id: string;
  model: string;
  name: string;
  categoryKey: string;
  categoryName: string;
  summary: string;
  bestImage: string;
  bestImageAlt: string;
}
interface Props {
  product: ProductCard;
}
const { product } = Astro.props;
const categoryCaptions: Record<string, string> = {
  'fixed-wing': 'Fixed-wing UAV',
  vtol: 'VTOL UAV',
  multirotor: 'Multirotor UAV',
  loitering: 'Loitering UAV',
  'fpv-kit': 'FPV Drone Kit',
  'fpv-frame': 'FPV Airframe',
  engine: 'Engine',
};
---

<article
  class="catalog-card"
  data-product-card
  data-category={product.categoryKey}
  data-search={`${product.model} ${product.name} ${product.categoryName} ${product.summary}`.toLocaleLowerCase()}
>
  <div class="catalog-card-media">
    <img src={product.bestImage} alt={product.bestImageAlt} loading="lazy" decoding="async" />
  </div>
  <div class="catalog-card-body">
    <h3>{product.model} {product.categoryName}</h3>
    <span class="catalog-card-type">{categoryCaptions[product.categoryKey] ?? product.categoryName}</span>
    <p title={product.summary}>{product.summary}</p>
  </div>
  <a
    class="catalog-card-link"
    href={`/products/${product.id}/`}
    aria-label={`查看 ${product.model} 产品详情`}
  ></a>
</article>
