<section class="yh-hero" aria-labelledby="yh-hero-title" data-yh-hero>
  <img
    class="yh-hero-poster"
    src="/media/hero/poster.webp"
    alt="沙地场景中人员检查黑色固定翼无人机"
    width="1280"
    height="720"
    fetchpriority="high"
  />
  <video
    class="yh-hero-video"
    data-yh-hero-video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/media/hero/poster.webp"
    aria-hidden="true"
  >
    <source src="/media/hero/hero.mp4" type="video/mp4" />
  </video>
  <div class="yh-hero-shade" aria-hidden="true"></div>
  <div class="yh-wrap yh-hero-content">
    <div class="yh-title-mask">
      <h1 id="yh-hero-title">
        <span>让专业飞行装备，</span>
        <span>抵达世界每一个重要现场。</span>
      </h1>
    </div>
    <span class="yh-hero-rule" aria-hidden="true"></span>
  </div>
  <button
    class="yh-hero-sound"
    type="button"
    data-yh-sound
    aria-label="开启视频声音"
    aria-pressed="false"
    hidden
  >
    <svg class="yh-sound-muted-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 9h3l4-3v12l-4-3H4zM16 9l5 6m0-6-5 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <svg class="yh-sound-on-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 9h3l4-3v12l-4-3H4zM15 9a4 4 0 0 1 0 6m2-9a8 8 0 0 1 0 12" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span data-yh-sound-label>开启声音</span>
  </button>
</section>
